generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum RequestStatus {
  OUVERTE
  AIDE_ACCEPTEE
  TERMINEE
}

enum OfferStatus {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role       Role     @default(STUDENT)
  specialite String   @default("Génie Logiciel")
  niveau     String   @default("ING 2")
  skills     String   @default("React, Next.js, Java")
  createdAt  DateTime @default(now())

  requests   HelpRequest[]
  offers     HelpOffer[]
  reviews    Review[]
}

model HelpRequest {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  subject      String        // Matière (ex: Web, Base de données, Algo)
  level        String        // Niveau ciblé (ex: L1, L2, ING 1)
  availability String        // Disponibilité (ex: "Samedi 14h - 16h")
  status       RequestStatus @default(OUVERTE)
  isReported   Boolean       @default(false) // Pour l'espace admin
  createdAt    DateTime      @default(now())

  authorId     Int
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  offers       HelpOffer[]
  review       Review?
}

model HelpOffer {
  id        Int         @id @default(autoincrement())
  message   String
  status    OfferStatus @default(EN_ATTENTE)
  createdAt DateTime    @default(now())

  requestId Int
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  helperId  Int
  helper    User        @relation(fields: [helperId], references: [id], onDelete: Cascade)
}

model Review {
  id        Int         @id @default(autoincrement())
  rating    Int         // Note de 1 à 5
  comment   String
  createdAt DateTime    @default(now())

  requestId Int         @unique
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorId  Int
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
}